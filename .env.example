# Copy to .env in this directory before: docker compose up --build
# Use letters and numbers only for the passwords.

MONGO_USER=hidevs
MONGO_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=https://example.com

# Browser-facing URLs. These are baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_DEPLOY_URL=https://example.com

# Set to false only when the site is served over http.
COOKIE_SECURE=true
